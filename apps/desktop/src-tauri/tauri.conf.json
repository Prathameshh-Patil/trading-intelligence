{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vision Hub",
  "version": "0.1.0",
  "identifier": "com.visionhub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Vision Hub",
        "width": 380,
        "height": 820,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Vision Hub",
    "copyright": "© 2026 Vision Hub",
    "category": "Finance",
    "shortDescription": "Order-flow overlay for gold futures",
    "longDescription": "A floating window that reads the tape for GC: signed delta, session CVD, absorption and outliers against measured base rates. Needs a licence key from your Vision Hub account.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NkI0RDA0NEU0QTMwREUKUldUZU1FcE9CRTFyS2RmZDFNQXZFVEJCWDFzRjQxclJyRFJuN0h1c0hGLzg4NUQvcjBuOEpIVVQK",
      "endpoints": [
        "https://github.com/Prathameshh-Patil/trading-intelligence/releases/latest/download/latest.json"
      ]
    }
  }
}
