{
  "manifest_version": 3,
  "name": "Trading Intelligence",
  "version": "0.1.0",
  "description": "AI-assisted market analysis and decision support.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Trading Intelligence",
    "default_popup": "index.html"
  }
}
