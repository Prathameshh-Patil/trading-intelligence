# Unset on purpose in development.
#
# With no value here the whole site runs against the mock data layer in
# `lib/mockApi.ts` — signup, payment, screenshot upload, admin approval and key
# issuance all work with no server running. Set it to point at `services/api`
# and the identical calls go over HTTP instead.
#
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# There is no build flag that opens the pre-release site to anyone with the
# link. The mock's release gate defaults closed — a fresh visitor sees the
# holding page — and the only way past it is an account. Two exist in the mock
# for handing to reviewers: see DEV_ADMIN and DEV_USER in lib/mockApi.ts.
