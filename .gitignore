.env
.env.*
!.env.example

.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

node_modules/
dist/

# apps/site (Next.js): the dev cache and the static export. Both are rebuilt
# from source on demand and .next/ alone runs into the hundreds of MB — never
# intentional content, same reasoning as data/ below.
.next/
/apps/site/out/

# The extension's build output is committed on purpose, so the extension can be
# loaded from a fresh clone without running a build first. Rebuild and commit it
# with any change under apps/extension/src.
!apps/extension/dist/

.DS_Store

*.log
# Scaffold/legacy files staged for manual removal — never intentional content.
_to_delete/

# Market data pulls (services/signal-data): raw DBN downloads and derived
# parquet. Hundreds of MB of binary — the billed downloads live here, but they
# are reproducible from Databento and must never enter git history.
data/
*.parquet
*.dbn
*.dbn.zst

# One exception: the S1 tick fixture (plans/team/contracts.md). One session,
# not a month, and every test in the project asserts against it — so it lives
# in git or nobody can work while the other one is asleep.
# `data/` excludes the directory itself, and git will not descend into an
# excluded directory, so every level has to be re-included before the file can
# be. A bare `!data/fixtures/gc_ticks_1session.parquet` silently does nothing.
!services/signal-data/data/
services/signal-data/data/*
!services/signal-data/data/fixtures/
services/signal-data/data/fixtures/*
!services/signal-data/data/fixtures/gc_ticks_1session.parquet

# reach.py's per-(month, side) count checkpoints. Derived, rebuildable, and
# stamped with the parameters they were produced under -- see reach.build.
services/signal-data/analysis/.reach_cache/
