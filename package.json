{
  "name": "trading-intelligence",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter extension dev",
    "dev:site": "pnpm --filter site dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm --filter extension build",
    "build:site": "pnpm --filter site build",
    "build:admin": "pnpm --filter admin build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "dev:desktop": "pnpm --filter desktop tauri dev",
    "build:desktop": "pnpm --filter desktop tauri build"
  }
}
