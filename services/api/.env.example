# Copy to services/api/.env — Settings loads .env relative to the working
# directory, and every command in the README runs from services/api.
# Credentials match the postgres service in docker-compose.yml at the repo root.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:local_dev_only@localhost:5432/trading_intelligence
# Analysis calls Claude, so this is required for the service to start.
# Tests only need it to be present, not valid — they mock the call.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Vision Hub auth ---------------------------------------------------------
# `uv run python -m app.cli gen-jwt-key` prints all three of these.
JWT_ACTIVE_KID=
JWT_KEYS=[]
KEY_ENCRYPTION_SECRET=
# The customer site and the admin portal, as origins. JSON list or comma-separated.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Production: COOKIE_SECURE=true and COOKIE_DOMAIN=.your-domain.tld so the
# refresh cookie is shared by the site and the admin portal.
COOKIE_SECURE=false
COOKIE_DOMAIN=
PROOF_DIR=var/proofs
RATE_LIMIT_AUTH_PER_MINUTE=10
